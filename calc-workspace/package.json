{
  "name": "@spanvision-infra/calc-workspace",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-brand.mjs && vite --host 127.0.0.1",
    "build": "node scripts/sync-brand.mjs && vite build",
    "build:lib": "node scripts/embed-sync.mjs && vite build -c vite.lib.config.ts && node scripts/embed-sync.mjs post",
    "pack:lib": "npm run build:lib && cd packages/embed && npm pack --pack-destination ../../release-embed",
    "dev:embed": "vite -c packages/embed/example/vite.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "brand:sync": "node scripts/sync-brand.mjs",
    "brand:validate": "node scripts/validate-brand.mjs",
    "check": "npm run brand:validate && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@thatopen/components": "^3.4.1",
    "@thatopen/components-front": "^3.4.1",
    "@thatopen/fragments": "^3.4.1",
    "@types/three": "^0.184.0",
    "7z-wasm": "^1.2.0",
    "buffer": "^6.0.3",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "mdb-reader": "^3.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.8",
    "sql.js": "^1.14.1",
    "three": "^0.184.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^29.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^4.1.0"
  },
  "description": "Spanvision Infra · Calc by Spanvision Infra",
  "keywords": [
    "construction",
    "estimating",
    "spanvision",
    "ifc"
  ]
}
