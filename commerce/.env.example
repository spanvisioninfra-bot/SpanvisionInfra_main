# Server settings only. Never prefix secrets with VITE_ or put them in public/.
# Copy to commerce/.env for local previews; keep the real .env out of Git.
# Use http://127.0.0.1:4230 locally; configure the live URL in Vercel separately.
SITE_URL=https://www.spanvisioninfra.com
# Neon is selected when either URL below is set. The supplied URL is public, not a password.
NEON_AUTH_BASE_URL=https://ep-crimson-brook-azf4zj7k.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth
# VITE_NEON_AUTH_URL with the same value is also accepted by the server.
# Private, server-only pooled PostgreSQL URL for the role granted spanvision_commerce_server.
# Keep sslmode=require in the connection string and URL-encode the password.
DATABASE_URL=
# Optional legacy provider. Leave these blank when using Neon.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required for admin activation: pin the verified administrator to its provider user ID.
# The designated email is spanvisioninfra.admin@gmail.com; client metadata cannot grant roles.
SUPER_ADMIN_USER_ID=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Existing Studio/Team plans were approved for trial-to-paid access.
# Configure provider keys, matching price IDs and verified webhooks before going live.
PRICING_APPROVED=true
BILLING_PROVIDER_IN=razorpay
BILLING_PROVIDER_GLOBAL=razorpay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Separate public INR 1 checkout. No plan purchase or tool access is granted.
# Apply neon-payment-test.sql first. Keep false until production is configured.
PAYMENT_TEST_ENABLED=false
# Configure one provider price/plan ID per approved region, plan and interval.
STRIPE_PRICE_STUDIO_MONTHLY_USD=
STRIPE_PRICE_STUDIO_ANNUAL_USD=
STRIPE_PRICE_STUDIO_MONTHLY_GBP=
STRIPE_PRICE_STUDIO_ANNUAL_GBP=
STRIPE_PRICE_TEAM_MONTHLY_USD=
STRIPE_PRICE_TEAM_ANNUAL_USD=
STRIPE_PRICE_TEAM_MONTHLY_GBP=
STRIPE_PRICE_TEAM_ANNUAL_GBP=
RAZORPAY_PLAN_STUDIO_MONTHLY_INR=
RAZORPAY_PLAN_STUDIO_ANNUAL_INR=
RAZORPAY_PLAN_TEAM_MONTHLY_INR=
RAZORPAY_PLAN_TEAM_ANNUAL_INR=
# The live account supports USD/GBP recurring plans. Supply matching plan IDs.
RAZORPAY_PLAN_STUDIO_MONTHLY_USD=
RAZORPAY_PLAN_STUDIO_ANNUAL_USD=
RAZORPAY_PLAN_TEAM_MONTHLY_USD=
RAZORPAY_PLAN_TEAM_ANNUAL_USD=
RAZORPAY_PLAN_STUDIO_MONTHLY_GBP=
RAZORPAY_PLAN_STUDIO_ANNUAL_GBP=
RAZORPAY_PLAN_TEAM_MONTHLY_GBP=
RAZORPAY_PLAN_TEAM_ANNUAL_GBP=
# Stripe remains an alternative: set BILLING_PROVIDER_GLOBAL=stripe and supply
# its secret, webhook secret and corresponding STRIPE_PRICE_* values instead.
