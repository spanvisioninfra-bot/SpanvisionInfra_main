# Server settings only. Never prefix secrets with VITE_ or put them in public/.
SITE_URL=http://127.0.0.1:4230
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required for admin activation: pin the verified administrator to its Supabase user UUID.
# The designated email is spanvisioninfra.admin@gmail.com; client metadata cannot grant roles.
SUPER_ADMIN_USER_ID=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Leave false while prices and package features are provisional.
PRICING_APPROVED=false
BILLING_PROVIDER_IN=razorpay
BILLING_PROVIDER_GLOBAL=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Configure one provider price/plan ID per approved region, plan and interval.
STRIPE_PRICE_STUDIO_MONTHLY_USD=
STRIPE_PRICE_STUDIO_ANNUAL_USD=
STRIPE_PRICE_STUDIO_MONTHLY_GBP=
STRIPE_PRICE_STUDIO_ANNUAL_GBP=
STRIPE_PRICE_TEAM_MONTHLY_USD=
STRIPE_PRICE_TEAM_ANNUAL_USD=
STRIPE_PRICE_TEAM_MONTHLY_GBP=
STRIPE_PRICE_TEAM_ANNUAL_GBP=
RAZORPAY_PLAN_STUDIO_MONTHLY_INR=
RAZORPAY_PLAN_STUDIO_ANNUAL_INR=
RAZORPAY_PLAN_TEAM_MONTHLY_INR=
RAZORPAY_PLAN_TEAM_ANNUAL_INR=
# If using approved Razorpay international payments for all countries, set
# BILLING_PROVIDER_GLOBAL=razorpay and supply corresponding USD/GBP plan IDs.
