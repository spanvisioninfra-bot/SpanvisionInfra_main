# Main site / Vercel Production. No values from this template go in VITE_* variables.
# Only the verified administrator configured by SUPER_ADMIN_USER_ID can access this test.
SITE_URL=https://www.spanvisioninfra.com
# Set true only after applying neon-payment-test.sql and adding live credentials.
PAYMENT_TEST_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Keep the existing SESSION_SECRET, DATABASE_URL and account settings unchanged.
# The one-time test does not need Razorpay subscription plan IDs or a webhook secret.
