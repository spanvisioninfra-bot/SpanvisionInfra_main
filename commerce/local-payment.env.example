# Local development only. Copy to .env.local-payment, which is ignored by Git.
# These keys are separate from subscription billing and never go in VITE_* variables.
# Use test-mode keys on localhost; live checkout requires a Razorpay-approved website.
LOCAL_PAYMENT_ENABLED=false
LOCAL_RAZORPAY_KEY_ID=
LOCAL_RAZORPAY_KEY_SECRET=
