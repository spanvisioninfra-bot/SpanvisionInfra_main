{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FEM Vision Studio",
  "version": "0.3.15",
  "identifier": "org.openaec.fem2d-studio",
  "build": {
    "frontendDist": "../design-mockup/dist",
    "devUrl": "http://localhost:1440",
    "beforeDevCommand": "npm --prefix design-mockup run dev",
    "beforeBuildCommand": "npm --prefix design-mockup run build"
  },
  "app": {
    "windows": [
      {
        "title": "FEM Vision Studio — Spanvision Infra",
        "label": "main",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: https://*.tile.openstreetmap.org; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https://nominatim.openstreetmap.org http://localhost:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage",
      "app",
      "dmg"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "resources": [
      "WebView2Loader.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Spanvision Infra",
    "copyright": "Spanvision Infra adaptation; original authors and licenses listed in THIRD_PARTY_NOTICES.md",
    "category": "Productivity",
    "shortDescription": "2D Finite Element Method solver",
    "longDescription": "FEM Vision Studio by Spanvision Infra — open-source 2D finite element modeling and structural analysis."
  },
  "plugins": {}
}
